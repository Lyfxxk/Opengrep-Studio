{
  "name": "opengrep-studio-server",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Opengrep Studio 后端：REST API + opengrep.exe 进程编排",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"scripts/*.test.mjs\"",
    "i18n:check": "node --import tsx scripts/i18n-check.mjs",
    "test-packs": "node --import tsx scripts/pack-regression.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "smoke:exe": "node scripts/smoke-exe.mjs"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "adm-zip": "^0.6.1",
    "express": "^5.3.0",
    "ignore": "^7.0.14",
    "js-yaml": "^5.5.0",
    "multer": "^2.0.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
